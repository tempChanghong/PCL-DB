<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PlainCraftDownloader</RootNamespace>
    <AssemblyName>PlainCraftDownloader</AssemblyName>
    <Title>Plain Craft Downloader</Title>
    <AssemblyTitle>Plain Craft Downloader</AssemblyTitle>
    <Product>Plain Craft Downloader</Product>
    <Description>Minecraft Java 原版下载补全工具</Description>
    <Version>0.47.0</Version>
    <AssemblyVersion>0.47.0.0</AssemblyVersion>
    <FileVersion>0.47.0.0</FileVersion>
    <OptionStrict>On</OptionStrict>
    <StartupObject>PlainCraftDownloader.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- VB WPF net48 requires this explicit reference (dotnet/wpf #11501). -->
    <Reference Include="mscorlib" />
    <Reference Include="Microsoft.VisualBasic" />
    <ProjectReference Include="../PlainCraftDownloader.Core/PlainCraftDownloader.Core.vbproj" />
  </ItemGroup>
  <ItemGroup><Resource Include="Images/Blocks/*.png"/><Resource Include="Images/Themes/*.png"/><Resource Include="Resources/Font.ttf"/></ItemGroup>
</Project>
