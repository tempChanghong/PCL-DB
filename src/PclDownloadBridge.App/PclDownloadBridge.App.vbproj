<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PclDownloadBridge</RootNamespace>
    <AssemblyName>PclDownloadBridge</AssemblyName>
    <Title>Plain Craft Launcher - Download Bridge</Title>
    <AssemblyTitle>Plain Craft Launcher - Download Bridge</AssemblyTitle>
    <Product>Plain Craft Launcher - Download Bridge</Product>
    <Description>Minecraft Java 原版下载补全工具</Description>
    <Version>6.0.0-beta.1</Version>
    <AssemblyVersion>6.0.0.0</AssemblyVersion>
    <FileVersion>6.0.0.0</FileVersion>
    <OptionStrict>On</OptionStrict>
    <StartupObject>PclDownloadBridge.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- VB WPF net48 requires this explicit reference (dotnet/wpf #11501). -->
    <Reference Include="mscorlib" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <ProjectReference Include="../PclDownloadBridge.Core/PclDownloadBridge.Core.vbproj" />
  </ItemGroup>
  <ItemGroup><Resource Include="Images/Blocks/*.png"/><Resource Include="Images/Icons/*.png"/><Resource Include="Images/Themes/*.png"/><Resource Include="Images/Heads/*.png;Images/Heads/*.jpg"/><Resource Include="Resources/Font.ttf"/></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../LICENCE;../../README.md;../../SOURCE_REFERENCES.md;../../THIRD_PARTY_NOTICES.md;../../VALIDATION.md;../../PATCH_MECHANISMS.md;../../VS2026_DEBUG.md"
                      LogicalName="PclDownloadBridge.Documents.%(Filename)%(Extension)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(PclDbSingleExecutable)' == 'true'">
    <DefineConstants>$(DefineConstants),PCD_SINGLE_EXE=-1</DefineConstants>
  </PropertyGroup>
  <!-- Resolve/build the actual project references before collecting their bytes. -->
  <Target Name="EmbedStandaloneDependencies" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences" Condition="'$(PclDbSingleExecutable)' == 'true'">
    <ItemGroup>
      <_StandaloneDependency Remove="@(_StandaloneDependency)" />
      <_StandaloneDependency Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' And ('%(ReferenceCopyLocalPaths.Filename)' == 'PclDownloadBridge.Core' Or '%(ReferenceCopyLocalPaths.Filename)' == 'Newtonsoft.Json')" />
      <EmbeddedResource Remove="@(_StandaloneDependency)" />
      <EmbeddedResource Include="@(_StandaloneDependency)" LogicalName="PclDownloadBridge.Dependencies.%(Filename)%(Extension)" />
    </ItemGroup>
    <Error Condition="'@(_StandaloneDependency->Count())' != '2'" Text="The single executable requires exactly Core and Newtonsoft.Json from the resolved references: @(_StandaloneDependency)" />
  </Target>
</Project>
