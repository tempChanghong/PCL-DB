<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PclDownloadBridge</RootNamespace>
    <AssemblyName>PclDownloadBridge</AssemblyName>
    <Title>Plain Craft Launcher (PCL) · Download Bridge（第三方下载补全版）</Title>
    <AssemblyTitle>Plain Craft Launcher (PCL) · Download Bridge（第三方下载补全版）</AssemblyTitle>
    <Product>Plain Craft Launcher (PCL) · Download Bridge（第三方下载补全版）</Product>
    <Description>Minecraft Java 原版下载补全工具</Description>
    <Version>0.52.0</Version>
    <AssemblyVersion>0.52.0.0</AssemblyVersion>
    <FileVersion>0.52.0.0</FileVersion>
    <OptionStrict>On</OptionStrict>
    <StartupObject>PclDownloadBridge.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- VB WPF net48 requires this explicit reference (dotnet/wpf #11501). -->
    <Reference Include="mscorlib" />
    <Reference Include="Microsoft.VisualBasic" />
    <ProjectReference Include="../PclDownloadBridge.Core/PclDownloadBridge.Core.vbproj" />
  </ItemGroup>
  <ItemGroup><Resource Include="Images/Blocks/*.png"/><Resource Include="Images/Themes/*.png"/><Resource Include="Resources/Font.ttf"/></ItemGroup>
</Project>
