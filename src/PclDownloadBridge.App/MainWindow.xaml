<Window x:Class="MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:PclDownloadBridge.Controls" Title="PCL-DB" Width="850" Height="500" MinWidth="810" MinHeight="470" FontFamily="{StaticResource PclFont}" FontSize="13" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing">
  <Grid Margin="10">
    <Border Margin="8" CornerRadius="6" Background="{DynamicResource WindowSurfaceBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.18" />
      </Border.Effect>
    </Border>
    <Border Margin="8" CornerRadius="6" ClipToBounds="True">
      <Grid x:Name="Shell">
        <Grid.Background>
          <LinearGradientBrush StartPoint="0.9,0" EndPoint="0.1,1">
            <GradientStop Color="#D9EEF9" Offset="0" />
            <GradientStop Color="#E4E9FB" Offset="1" />
          </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
          <RowDefinition Height="48" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" MouseLeftButtonDown="DragTitle">
          <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#2584E9" Offset="0" />
              <GradientStop Color="#3896F7" Offset="0.5" />
              <GradientStop Color="#2584E9" Offset="1" />
            </LinearGradientBrush>
          </Grid.Background>
          <Image x:Name="TitleTexture" Source="Images/Themes/12.png" Stretch="UniformToFill" IsHitTestVisible="False" IsEnabled="False" Visibility="Collapsed" RenderOptions.BitmapScalingMode="LowQuality"/>
          <TextBlock x:Name="ProductTitle" Text="PCL-DB" Foreground="White" FontSize="15" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
          <StackPanel x:Name="TopTabs" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="27">
            <p:PclRadioButton x:Name="DownloadTab" Text="下载" Checked="True" Margin="5,0" Logo="{StaticResource IconTitle下载}" Click="ShowDownload" />
            <p:PclRadioButton x:Name="SettingsTab" Text="设置" Margin="5,0" Logo="{StaticResource IconTitle设置}" Click="ShowSettings" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
            <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow" Margin="0,0,4,0">
              <Path Data="M0,0 H15 V2 H0 Z" Fill="White" Width="12" Stretch="Uniform" />
            </Button>
            <Button Style="{StaticResource CaptionButton}" Click="CloseWindow">
              <Path Data="M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 Z" Fill="White" Width="12" Height="12" Stretch="Uniform" />
            </Button>
          </StackPanel>
        </Grid>
        <Grid x:Name="PageSurface" Grid.Row="1" ClipToBounds="True">
            <Grid x:Name="DownloadPage">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="25,14,25,0" Height="30">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="安装到" Opacity="0.6" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock x:Name="SelectedPath" Grid.Column="1" Text="请选择 PCL 的 .minecraft 文件夹" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <p:PclButton x:Name="ChangeFolderButton" Text="更改目录" Width="86" Height="28" Margin="10,0,0,0" Click="ChooseInstallFolder" />
                  <p:PclButton x:Name="ProgressShortcut" Text="查看下载进度" Width="112" Height="28" Margin="10,0,0,0" Visibility="Collapsed" Click="ShowProgress" />
                  <p:PclButton x:Name="RefreshButton" Text="刷新列表" Width="86" Height="28" Margin="10,0,0,0" Click="RefreshVersions" />
                </StackPanel>
              </Grid>
              <Grid x:Name="DownloadViewHost" Grid.Row="1" ClipToBounds="True">
              <Grid x:Name="VersionPage">
              <p:PclScrollViewer x:Name="VersionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="VersionCards" Margin="25,15,25,25" />
              </p:PclScrollViewer>
              <TextBlock x:Name="EmptyVersions" Text="正在获取 Minecraft 版本列表…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
              </Grid>
              <Grid x:Name="InstallPage" Visibility="Collapsed">
                <p:PclScrollViewer x:Name="InstallScroll" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="25,15,25,85">
                    <p:PclCard ShowHeader="False" BodyMargin="0" Margin="0,0,0,15">
                      <Grid Height="62">
                        <p:PclIconButton x:Name="InstallBack" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" Click="BackToVersions" ToolTip="返回" Opacity="0.6" LogoScale="0.87" Logo="M1097 584 250 584 562 896C591 925 591 972 562 1001 533 1030 487 1030 458 1001L21 565C6 550-0 531 0 511L0 511 0 511C-0 492 6 472 21 457L458 21C487-7 533-7 562 21 591 50 591 97 562 126L250 438 1097 438C1137 438 1170 471 1170 511 1170 551 1137 584 1097 584L1097 584Z" />
                        <Image x:Name="SelectedVersionIcon" Source="Images/Blocks/Grass.png" HorizontalAlignment="Left" Width="32" Height="32" Margin="52,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <p:PclTextBox x:Name="InstanceName" Margin="93,16,16,0" Padding="-1,0" MinHeight="30" FontSize="15" VerticalAlignment="Top" MaxLength="70" HasBackground="False" ShowValidateResult="False" ToolTip="版本名称" />
                      </Grid>
                    </p:PclCard>
                    <p:PclHint x:Name="NameHint" Visibility="Collapsed" Margin="0,0,0,12" />
                    <p:PclCard x:Name="VanillaCard" Title="Minecraft" Height="40" Margin="0,0,0,12">
                      <p:PclCard.HeaderContent>
                        <StackPanel Orientation="Horizontal" Height="18" VerticalAlignment="Center">
                          <Image x:Name="VanillaVersionIcon" Source="Images/Blocks/Grass.png" Width="18" Height="18" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="Linear" />
                          <TextBlock x:Name="SelectedVersionText" Text="原版游戏" VerticalAlignment="Center" />
                        </StackPanel>
                      </p:PclCard.HeaderContent>
                    </p:PclCard>
                    <p:PclCard Title="版本隔离" Margin="0,0,0,12">
                      <StackPanel>
                        <p:PclComboBox x:Name="IsolationBox" SelectedIndex="0" Height="28">
                          <p:PclComboBoxItem Content="跟随 PCL" />
                          <p:PclComboBoxItem Content="开启隔离" />
                          <p:PclComboBoxItem Content="关闭隔离" />
                        </p:PclComboBox>
                        <TextBlock x:Name="IsolationHint" Text="跟随所选 PCL 的默认隔离策略；未找到设置时使用 PCL 默认值。" TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,8,0,0" />
                      </StackPanel>
                    </p:PclCard>
                    <StackPanel x:Name="ComponentCards" />
                    <TextBlock x:Name="ComponentHint" FontSize="12" TextWrapping="Wrap" Opacity="0.65" Margin="0,3,0,12" />
                    <p:PclCard Title="校验与补全" Collapsible="True" Collapsed="True" Margin="0,0,0,12">
                      <StackPanel>
                        <p:PclCheckBox x:Name="RepairBox" Content="校验补全已存在的同版本原版" />
                        <TextBlock Text="仅支持未添加加载器的原版实例，不覆盖已有实例配置。" TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,8,0,0" />
                      </StackPanel>
                    </p:PclCard>
                  </StackPanel>
                </p:PclScrollViewer>
                <Button x:Name="InstallButton" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="52" Margin="20" Click="StartInstall" Cursor="Hand" ToolTipService.ShowOnDisabled="True">
                  <Button.Template><ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                      <Border x:Name="InstallSurface" CornerRadius="20.8" Margin="0,10,0,0" Background="{DynamicResource ColorBrush3}">
                        <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.2"/></Border.Effect>
                        <StackPanel Orientation="Horizontal" Margin="20,0">
                          <Path Data="M955 610h-59c-15 0-29 13-29 29v196c0 15-13 29-29 29h-649c-15 0-29-13-29-29v-196c0-15-13-29-29-29h-59c-15 0-29 13-29 29V905c0 43 35 78 78 78h787c43 0 78-35 78-78V640c0-15-13-29-29-29zM492 740c11 11 29 11 41 0l265-265c11-11 11-29 0-41l-41-41c-11-11-29-11-41 0l-110 110c-11 11-33 3-33-13V68C571 53 555 39 541 39h-59c-15 0-29 13-29 29v417c0 17-21 25-33 13l-110-110c-11-11-29-11-41 0L226 433c-11 11-11 29 0 41L492 740z" Fill="{DynamicResource ColorBrush8}" Stretch="Uniform" Width="18" Margin="2,12,0,12"/>
                          <TextBlock Text="开始下载" Foreground="{DynamicResource ColorBrush8}" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0.8"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InstallSurface" Property="Background" Value="{DynamicResource ColorBrush4}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InstallSurface" Property="Background" Value="{DynamicResource ColorBrushGray4}"/></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate></Button.Template>
                </Button>
              </Grid>
            <p:PclScrollViewer x:Name="DownloadProgress" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="25,15,25,10">
              <p:PclCard Title="下载任务" VerticalAlignment="Top" BodyMargin="25,40,15,15" HeaderContentMargin="132,0,15,0">
                <p:PclCard.HeaderContent><p:PclButton Text="返回安装选项" Width="112" Height="27" HorizontalAlignment="Right" Click="ResumeInstallation" /></p:PclCard.HeaderContent>
                <StackPanel>
                  <TextBlock x:Name="TaskTitle" Text="暂无正在进行的任务" FontWeight="Bold" Margin="0,0,0,14" />
                  <StackPanel x:Name="TaskPanel">
                    <ProgressBar x:Name="TaskProgress" Height="3" Maximum="1" Foreground="{DynamicResource ColorBrush3}" Background="{DynamicResource ColorBrush7}" BorderThickness="0" />
                    <Grid x:Name="TaskStats" Margin="0,15,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Grid.Resources><Style x:Key="TaskStatTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource ColorBrush3}"/></Style><Style x:Key="TaskStatSplit" TargetType="Border"><Setter Property="Height" Value="2"/><Setter Property="Margin" Value="0,7,25,7"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="0"/><GradientStop Color="{DynamicResource ColorObject3}" Offset="0.02"/><GradientStop Color="{DynamicResource ColorObject3}" Offset="0.98"/><GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></Style></Grid.Resources>
                      <StackPanel><TextBlock Text="总进度" Style="{StaticResource TaskStatTitle}"/><Border Style="{StaticResource TaskStatSplit}"/><TextBlock x:Name="TaskPercent" Text="0.00 %" FontSize="20"/></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock Text="下载速度" Style="{StaticResource TaskStatTitle}"/><Border Style="{StaticResource TaskStatSplit}"/><TextBlock x:Name="TaskSpeed" Text="0 B/s" FontSize="20"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="剩余文件" ToolTip="当前下载阶段尚未完成的文件数" Style="{StaticResource TaskStatTitle}"/><Border Style="{StaticResource TaskStatSplit}"/><TextBlock x:Name="TaskRemaining" Text="—" FontSize="20"/></StackPanel>
                      <StackPanel Grid.Column="3"><TextBlock Text="活动连接" Style="{StaticResource TaskStatTitle}"/><Border Style="{StaticResource TaskStatSplit}"/><TextBlock x:Name="TaskConnections" Text="—" FontSize="20"/></StackPanel>
                    </Grid>
                    <StackPanel x:Name="TaskPhases" Margin="-11,0,0,0" />
                    <TextBlock x:Name="TaskDetail" Text="选择原版版本后即可安装" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                    <TextBlock x:Name="DeveloperTaskInfo" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.65"/>
                  </StackPanel>
                  <p:PclButton x:Name="CancelButton" Text="取消任务" Width="110" Height="32" HorizontalAlignment="Right" Margin="0,20,0,0" IsEnabled="False" Click="CancelInstall" />
                  <TextBlock x:Name="TaskResultLocation" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,10,0,0"/>
                  <WrapPanel x:Name="TaskResultActions" Visibility="Collapsed" Margin="0,12,0,0">
                    <p:PclButton x:Name="OpenTaskFolderButton" Text="打开版本文件夹" Width="140" Height="32" Margin="0,0,12,8" ToolTipService.ShowOnDisabled="True" Click="OpenTaskFolder"/>
                    <p:PclButton x:Name="OpenTaskLogButton" Text="打开安装器日志" Width="140" Height="32" Margin="0,0,12,8" ToolTipService.ShowOnDisabled="True" Click="OpenInstallerLog"/>
                    <p:PclButton x:Name="CopyTaskInfoButton" Text="复制任务信息" Width="140" Height="32" Margin="0,0,12,8" Click="CopyTaskInformation"/>
                  </WrapPanel>
                  <TextBlock x:Name="TaskActionStatus" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
                  <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,16,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
              </p:PclCard>
              <p:PclCard x:Name="TransferCard" Title="传输详情" Collapsible="True" Collapsed="True">
                <StackPanel>
                  <TextBlock x:Name="TransferStats" Text="暂无传输数据" TextWrapping="Wrap" Margin="0,0,0,8" />
                  <TextBlock x:Name="TransferFile" Text="—" TextWrapping="Wrap" FontSize="12" Opacity="0.65" Margin="0,0,0,8"/>
                  <TextBlock x:Name="TransferSource" Text="—" FontSize="12" Opacity="0.65"/>
                  <p:PclButton Text="打开安装器日志" Width="140" Height="32" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenInstallerLog"/>
                </StackPanel>
              </p:PclCard>
              </StackPanel>
            </p:PclScrollViewer>
            </Grid>
            </Grid>
            <p:PclScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="SettingsContent" Margin="25" Grid.IsSharedSizeScope="True">
                <StackPanel.Resources><Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,25,0"/></Style></StackPanel.Resources>
                <p:PclButton x:Name="AboutEntry" Text="关于 PCL-DB" Width="140" Height="28" HorizontalAlignment="Right" Margin="0,0,0,15" Click="ShowAbout" />
                <p:PclCard x:Name="AppearanceCard" Title="个性化 · 基础" BodyMargin="25,40,25,17">
                  <Grid x:Name="AppearanceGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Name"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="7"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="不透明度" Style="{StaticResource SettingLabel}"/>
                    <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                      <p:PclSlider x:Name="OpacitySlider" Minimum="0" Maximum="600" SmallChange="10" LargeChange="100" Value="600" AutomationProperties.Name="窗口不透明度"/>
                      <TextBlock x:Name="OpacityValue" Text="100%" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="主题" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" Margin="0,5,25,0"/>
                    <UniformGrid x:Name="AppearanceThemes" Grid.Row="2" Grid.Column="1" Columns="3"/>
                    <Grid x:Name="CustomThemeGrid" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,7,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Name"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="7"/><RowDefinition Height="28"/><RowDefinition Height="7"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                      <TextBlock Text="色调" Style="{StaticResource SettingLabel}"/>
                      <p:PclSlider x:Name="HueSlider" Grid.Column="1" Minimum="0" Maximum="360" Value="180" SmallChange="10" LargeChange="30" AutomationProperties.Name="自定义主题色调"/>
                      <TextBlock x:Name="HueValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                      <TextBlock Text="饱和度" Grid.Row="2" Style="{StaticResource SettingLabel}"/>
                      <p:PclSlider x:Name="SaturationSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="80" SmallChange="5" LargeChange="10" AutomationProperties.Name="自定义主题饱和度"/>
                      <TextBlock x:Name="SaturationValue" Grid.Row="2" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                      <TextBlock Text="亮度" Grid.Row="4" Style="{StaticResource SettingLabel}"/>
                      <p:PclSlider x:Name="LightnessSlider" Grid.Row="4" Grid.Column="1" Minimum="-20" Maximum="20" SmallChange="1" LargeChange="5" AutomationProperties.Name="自定义主题亮度"/>
                      <TextBlock x:Name="LightnessValue" Grid.Row="4" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0">
                      <p:PclCheckBox x:Name="DarkModeBox" Content="深色模式" Margin="0,0,24,0"/>
                      <p:PclCheckBox x:Name="ColorfulBackgroundBox" Content="叠加主题背景" IsChecked="True" Margin="0,0,24,0"/>
                      <p:PclCheckBox x:Name="TitleTextureBox" Content="彩色主题标题纹理" IsChecked="True"/>
                    </WrapPanel>
                    <p:PclButton Grid.Row="5" Grid.Column="1" Text="恢复默认外观" Width="140" Height="35" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ResetAppearance"/>
                  </Grid>
                </p:PclCard>
                <p:PclCard x:Name="GameFolderCard" Title="游戏文件夹" BodyMargin="25,37,25,15">
                  <Grid x:Name="FolderSettingsGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Name"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="游戏目录" Style="{StaticResource SettingLabel}"/>
                    <p:PclComboBox x:Name="FolderList" Grid.Column="1" SelectionChanged="FolderSelected" MinHeight="49" HorizontalContentAlignment="Stretch" ToolTip="选择 PCL 使用的 .minecraft 文件夹">
                      <p:PclComboBox.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,2">
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Text="{Binding Location}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        </StackPanel>
                      </DataTemplate></p:PclComboBox.ItemTemplate>
                    </p:PclComboBox>
                    <TextBlock x:Name="FolderSummary" Grid.Column="1" Grid.Row="1" Text="安装前请选择游戏文件夹" FontSize="12" Opacity="0.5" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <WrapPanel Grid.Column="1" Grid.Row="2" Margin="0,10,0,0">
                      <p:PclButton Text="读取 PCL 的目录" Width="140" Height="35" Margin="0,0,20,0" Click="ChoosePcl" />
                      <p:PclButton Text="手动选择目录" Width="140" Height="35" Click="ChooseFolder" />
                    </WrapPanel>
                    <TextBlock x:Name="PclLocation" Grid.Column="1" Grid.Row="3" FontSize="12" Opacity="0.5" Margin="0,10,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                  </Grid>
                </p:PclCard>
                <p:PclCard x:Name="DownloadSettingsCard" Title="下载与安装" BodyMargin="25,37,25,15">
                  <Grid x:Name="DownloadSettingsGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Name"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="7"/><RowDefinition Height="28"/><RowDefinition Height="7"/><RowDefinition Height="28"/><RowDefinition Height="7"/><RowDefinition Height="Auto" MinHeight="28"/><RowDefinition Height="7"/><RowDefinition Height="22"/><RowDefinition Height="7"/><RowDefinition Height="Auto" MinHeight="28"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="文件下载源" Style="{StaticResource SettingLabel}"/>
                    <p:PclComboBox x:Name="SourceBox" Grid.Column="1" SelectedIndex="1" AutomationProperties.Name="文件下载源" ToolTip="选择游戏文件与组件文件的优先下载来源。">
                      <p:PclComboBoxItem Content="尽量使用 BMCLAPI" />
                      <p:PclComboBoxItem Content="优先使用官方源，在加载缓慢时换用 BMCLAPI" />
                      <p:PclComboBoxItem Content="尽量使用官方源" />
                    </p:PclComboBox>
                    <TextBlock Grid.Row="2" Text="版本列表源" Style="{StaticResource SettingLabel}"/>
                    <p:PclComboBox x:Name="VersionSourceBox" Grid.Row="2" Grid.Column="1" SelectedIndex="1" AutomationProperties.Name="版本列表源" ToolTip="选择 Minecraft 与组件版本列表的优先来源；返回下载页时刷新，保留已选版本与名称。">
                      <p:PclComboBoxItem Content="尽量使用 BMCLAPI（可能缺少刚刚更新的版本）" />
                      <p:PclComboBoxItem Content="优先使用官方源，在加载缓慢时换用 BMCLAPI" />
                      <p:PclComboBoxItem Content="尽量使用官方源" />
                    </p:PclComboBox>
                    <TextBlock Grid.Row="4" Text="最大连接数" Style="{StaticResource SettingLabel}"/>
                    <Grid Grid.Row="4" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                      <p:PclSlider x:Name="ConnectionsSlider" Minimum="8" Maximum="64" Ticks="8,16,32,64" Value="64" SmallChange="1" LargeChange="8" ValueChanged="ConnectionsChanged" AutomationProperties.Name="最大下载连接数" ToolTip="连接数越多，同时下载的文件越多；最高 64 个连接。"/>
                      <TextBlock x:Name="ConnectionValue" Grid.Column="1" Text="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="6" Text="速度限制" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" Margin="0,5,25,0"/>
                    <Grid Grid.Row="6" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <p:PclTextBox x:Name="SpeedLimitBox" Text="0" TextChanged="SpeedLimitChanged"/>
                      <TextBlock Grid.Column="1" Text="MiB/s，0 为不限速" Margin="10,5,0,0" VerticalAlignment="Top" Opacity="0.5"/>
                    </Grid>
                    <TextBlock Grid.Row="8" Text="文件复用" Style="{StaticResource SettingLabel}"/>
                    <p:PclCheckBox x:Name="ReuseBox" Grid.Row="8" Grid.Column="1" IsChecked="True" Content="复用其他游戏文件夹中的文件"/>
                    <TextBlock Grid.Row="10" Text="安装 Java" Style="{StaticResource SettingLabel}"/>
                    <Grid Grid.Row="10" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <p:PclTextBox x:Name="JavaPathBox" HintText="自动寻找 Java" ToolTip="留空时自动寻找 Java；Forge、NeoForge 和独立 OptiFine 安装需要 Java" />
                      <p:PclButton Text="选择" Width="65" Height="28" Grid.Column="1" Margin="10,0,0,0" Click="ChooseJava" />
                    </Grid>
                    <TextBlock Grid.Row="11" Grid.Column="1" Text="镜像源为 BMCLAPI；优先来源不可用时会尝试备用来源。" TextWrapping="Wrap" FontSize="12" Opacity="0.5" Margin="0,10,0,0"/>
                    <Grid Grid.Row="12" Grid.Column="1" Margin="0,12,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <p:PclButton x:Name="SaveSettingsButton" Text="保存设置" Width="140" Height="35" HorizontalAlignment="Left" VerticalAlignment="Top" Click="SaveSettings" />
                      <TextBlock x:Name="SettingsSaveFeedback" Grid.Column="1" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="15,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                  </Grid>
                </p:PclCard>
                <p:PclCard x:Name="DeveloperCard" Title="开发者设置" BodyMargin="25,37,25,15">
                  <StackPanel>
                    <p:PclCheckBox x:Name="DeveloperEnabledBox" Content="启用开发者设置" Checked="DeveloperEnabledChanged" Unchecked="DeveloperEnabledChanged"/>
                    <StackPanel x:Name="DeveloperOptions" Visibility="Collapsed" Margin="0,14,0,0">
                      <TextBlock Text="常规" FontWeight="Bold" Margin="0,0,0,8"/>
                      <p:PclCheckBox x:Name="DeveloperDiagnosticsBox" Content="显示下载诊断信息" Checked="DeveloperDiagnosticChanged" Unchecked="DeveloperDiagnosticChanged"/>
                      <p:PclButton Text="打开程序日志" Width="140" Height="35" HorizontalAlignment="Left" Margin="0,10,0,16" Click="OpenLogs"/>
                      <TextBlock Text="实验性外观" FontWeight="Bold" Margin="0,0,0,8"/>
                      <TextBlock Text="验证后，其他主题会出现在上方的个性化列表中。关闭开发者设置或重启后重新锁定。" TextWrapping="Wrap" FontSize="12" Opacity="0.65" Margin="0,0,0,8"/>
                      <Grid x:Name="DeveloperUnlockRow"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="DeveloperCodeBox" MaxLength="128" Height="30" Padding="8,4" FontFamily="{StaticResource PclFont}" Foreground="{DynamicResource ColorBrush1}" Background="{DynamicResource ColorBrushHalfWhite}" BorderBrush="{DynamicResource ColorBrushBg0}" BorderThickness="1" KeyDown="DeveloperCodeKeyDown" AutomationProperties.Name="实验性外观验证码"/>
                        <p:PclButton x:Name="DeveloperUnlockButton" Text="验证解锁" Grid.Column="1" Width="100" Height="30" Margin="10,0,0,0" Click="UnlockDeveloperThemes"/>
                      </Grid>
                      <p:PclButton x:Name="DeveloperLockButton" Text="重新锁定" Width="140" Height="30" HorizontalAlignment="Left" Visibility="Collapsed" Click="LockDeveloperThemes"/>
                      <TextBlock x:Name="DeveloperUnlockStatus" Text="尚未解锁" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                  </StackPanel>
                </p:PclCard>
                <TextBlock Text="{Binding Text, ElementName=StatusText}" FontSize="12" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,15" />
                <p:PclButton Text="打开日志文件夹" Width="140" Height="35" HorizontalAlignment="Left" Click="OpenLogs" />
                <TextBlock Text="PCL-DB · 基于 PCL2 源代码制作的独立下载补全工具，非 PCL 官方发行版。" TextWrapping="Wrap" FontSize="12" Opacity="0.55" Margin="0,15,0,0" />
              </StackPanel>
            </p:PclScrollViewer>
            <p:PclScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <p:PclScrollViewer.Resources>
                <Style x:Key="AboutPortrait" TargetType="Image">
                  <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="3"/>
                  <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="RenderOptions.BitmapScalingMode" Value="LowQuality"/>
                  <Setter Property="Clip"><Setter.Value><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17"/></Setter.Value></Setter>
                </Style>
                <Style x:Key="AboutBadge" TargetType="Border">
                  <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="3"/>
                  <Setter Property="CornerRadius" Value="17"/><Setter Property="VerticalAlignment" Value="Center"/>
                  <Setter Property="Background" Value="{DynamicResource ColorBrush7}"/>
                </Style>
              </p:PclScrollViewer.Resources>
              <StackPanel x:Name="AboutContent" Margin="25,10,25,25">
                <StackPanel Orientation="Horizontal" Height="28" Margin="0,5,0,0">
                  <p:PclIconButton x:Name="AboutBack" Width="24" Height="24" Opacity="0.65" LogoScale="0.87" Click="BackFromAbout" ToolTip="返回设置" AutomationProperties.Name="返回设置" Logo="M1097 584 250 584 562 896C591 925 591 972 562 1001 533 1030 487 1030 458 1001L21 565C6 550-0 531 0 511L0 511 0 511C-0 492 6 472 21 457L458 21C487-7 533-7 562 21 591 50 591 97 562 126L250 438 1097 438C1137 438 1170 471 1170 511 1170 551 1137 584 1097 584L1097 584Z"/>
                  <TextBlock Text="关于与鸣谢" FontSize="12" Opacity="0.65" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <p:PclCard x:Name="AboutAuthorCard" Title="关于" BodyMargin="21,40,21,16" Margin="0,15,0,15">
                  <Grid x:Name="AboutProductGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="45"/><RowDefinition Height="45"/></Grid.RowDefinitions>
                    <Image x:Name="AboutAuthorAvatar" Style="{StaticResource AboutPortrait}" Source="Images/Heads/LTCat.jpg" AutomationProperties.Name="龙腾猫跃头像"/>
                    <p:PclListItem x:Name="AboutAuthorItem" Grid.Column="1" Title="龙腾猫跃" Info="Plain Craft Launcher 的开发者！" Margin="-5,0,15,0" IsHitTestVisible="False" ClipToBounds="True"/>
                    <p:PclButton x:Name="AboutPclSponsor" Grid.Column="2" Text="赞助 PCL !" Tag="pcl-sponsor" Height="35" Highlight="True" Click="OpenAboutLink"/>
                    <Image x:Name="AboutContributorAvatar" Grid.Row="1" Style="{StaticResource AboutPortrait}" Source="Images/Heads/HerobrineXia.png" AutomationProperties.Name="HerobrineXia 头像"/>
                    <p:PclListItem x:Name="AboutContributorItem" Grid.Row="1" Grid.Column="1" Title="HerobrineXia" Info="Plain Craft Launcher 的协力开发者！" Margin="-5,0,15,0" IsHitTestVisible="False" ClipToBounds="True"/>
                    <p:PclButton x:Name="AboutPclSource" Grid.Row="1" Grid.Column="2" Text="PCL 源代码" Tag="pcl" Height="35" Click="OpenAboutLink"/>
                    <Border Grid.Row="2" Style="{StaticResource AboutBadge}" Background="{DynamicResource ColorBrush3}">
                      <TextBlock x:Name="AboutMonogram" Text="DB" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="AboutProductText" Grid.Row="2" Grid.Column="1" Margin="-5,0,15,0" Background="Transparent">
                      <p:PclListItem x:Name="AboutProductItem" Title="Plain Craft Launcher - Download Bridge" IsHitTestVisible="False" ClipToBounds="True"/>
                    </Border>
                    <p:PclButton x:Name="AboutCopyVersion" Grid.Row="2" Grid.Column="2" Text="复制版本信息" Height="35" Click="CopyAboutVersion"/>
                  </Grid>
                </p:PclCard>
                <p:PclCard x:Name="AboutCreditsCard" Title="特别鸣谢" BodyMargin="21,40,21,16" Margin="0,0,0,15">
                  <Grid x:Name="AboutCreditsGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="45"/></Grid.RowDefinitions>
                    <Image x:Name="AboutMirrorAvatar" Style="{StaticResource AboutPortrait}" Source="Images/Heads/bangbang93.png" AutomationProperties.Name="bangbang93 头像"/>
                    <p:PclListItem Grid.Column="1" Title="bangbang93" Info="提供 BMCLAPI 镜像源与开放项目。" Margin="-5,0,15,0" IsHitTestVisible="False" ClipToBounds="True"/>
                    <p:PclButton x:Name="AboutBmclapi" Grid.Column="2" Text="BMCLAPI 项目" Tag="bmclapi" Height="35" Click="OpenAboutLink"/>
                    <Border Grid.Row="1" Style="{StaticResource AboutBadge}">
                      <Path Width="18" Height="20" Stretch="Uniform" Stroke="{DynamicResource ColorBrush2}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M 10,1 19,6 19,16 10,21 1,16 1,6 Z M 1,6 10,11 19,6 M 10,11 V 21"/>
                    </Border>
                    <p:PclListItem Grid.Row="1" Grid.Column="1" Title="PCL-CE · HMCL · PrismLauncher" Info="下载与实例组织的补充参照。" Margin="-5,0,15,0" IsHitTestVisible="False" ClipToBounds="True"/>
                    <p:PclButton x:Name="AboutReferences" Grid.Row="1" Grid.Column="2" Text="代码依据" Tag="SOURCE_REFERENCES.md" Height="35" Click="OpenAboutDocument"/>
                  </Grid>
                </p:PclCard>
                <p:PclCard x:Name="AboutProjectCard" Title="项目与许可" BodyMargin="21,40,21,16" Margin="0,0,0,15">
                  <Grid x:Name="AboutProjectGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="45"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource AboutBadge}">
                      <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ColorBrush2}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 10,1 V 13 M 5,8 10,13 15,8 M 2,14 V 19 H 18 V 14"/>
                    </Border>
                    <p:PclListItem Grid.Column="1" Title="与 PCL 配合使用" Info="补全游戏下载与安装，启动游戏交给 PCL。" Margin="-5,0,15,0" IsHitTestVisible="False" ClipToBounds="True"/>
                    <p:PclButton Grid.Column="2" Text="项目说明" Tag="README.md" Height="35" Click="OpenAboutDocument"/>
                    <Border Grid.Row="1" Style="{StaticResource AboutBadge}">
                      <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ColorBrush2}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 7,1 H 5 Q 3,1 3,4 V 7 Q 3,10 1,10 Q 3,10 3,13 V 16 Q 3,19 5,19 H 7 M 13,1 H 15 Q 17,1 17,4 V 7 Q 17,10 19,10 Q 17,10 17,13 V 16 Q 17,19 15,19 H 13"/>
                    </Border>
                    <p:PclListItem Grid.Row="1" Grid.Column="1" Title="Newtonsoft.Json" Info="James Newton-King · MIT License" Margin="-5,0,15,0" IsHitTestVisible="False" ClipToBounds="True"/>
                    <p:PclButton x:Name="AboutNotices" Grid.Row="1" Grid.Column="2" Text="第三方说明" Tag="THIRD_PARTY_NOTICES.md" Height="35" Click="OpenAboutDocument"/>
                  </Grid>
                </p:PclCard>
                <StackPanel Margin="0,0,0,15">
                  <TextBlock x:Name="AboutRuntimeInfo" FontSize="12" Opacity="0.6" Margin="0,0,0,6"/>
                  <TextBlock Text="本项目为第三方独立二次创作的下载补全工具，非 PCL 官方发行版。" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Opacity="0.6"/>
                </StackPanel>
                <TextBlock x:Name="AboutActionStatus" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
            </p:PclScrollViewer>
            <Canvas x:Name="PageGhost" IsHitTestVisible="False" ClipToBounds="True"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
