<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Version>8.0.0-beta.1</Version>
    <AssemblyVersion>8.0.0.0</AssemblyVersion>
    <FileVersion>8.0.0.0</FileVersion>
    <RootNamespace>PclDownloadBridge.Core</RootNamespace>
    <AssemblyName>PclDownloadBridge.Core</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <!-- Retain VB conversion/module semantics for existing VB consumers. -->
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml.Linq" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="Resources/OptiFineBridge.class" LogicalName="OptiFineBridge.class" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Resources/PclWikiEntries.txt" LogicalName="PclWikiEntries.txt" /></ItemGroup>
</Project>
